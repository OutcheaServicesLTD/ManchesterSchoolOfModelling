{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=msm-portfolio.db",
    "MigrateOnStartup": true
  },

  "Msm": {
    // Overrides the real domain locally, so the portfolio link shown on the client and
    // admin dashboards is one that actually opens on this machine. It has to match the
    // address the application is served on — the http profile, which is what the start
    // script and the VS Code configuration both use.
    "PublicDomain": "http://localhost:5213"
  }
}
