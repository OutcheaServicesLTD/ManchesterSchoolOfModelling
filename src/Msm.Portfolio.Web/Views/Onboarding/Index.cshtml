@model Msm.Portfolio.Web.ViewModels.OnboardingViewModel
@using Msm.Portfolio.Web.Domain.Enums
@{
    ViewData["Title"] = "Your details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1>Your details</h1>
        <p class="lead">
            Please complete your details so we can build your portfolio. It only takes a few minutes.
        </p>

        <form method="post" novalidate>
            @* Carried through from the CRM link and never shown to the client. *@
            <input type="hidden" asp-for="GhlContactId" />

            <div asp-validation-summary="All" class="alert alert-danger" role="alert"
                 style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

            <fieldset class="mb-4">
                <legend class="h5">About you</legend>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayName" class="form-label"></label>
                    <input asp-for="DisplayName" class="form-control" />
                    <div class="form-text">Leave blank to use your own name on your portfolio.</div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <div class="form-text">Never shown on your public portfolio.</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                        <div class="form-text">Never shown on your public portfolio.</div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ModelProfileType" class="form-label"></label>
                    @* Changing the type changes which measurements are asked for, so the
                       form is re-fetched. Bound in msm.js rather than inline, because the
                       Content Security Policy allows no inline script. *@
                    <select asp-for="ModelProfileType" class="form-select"
                            asp-items="@Html.GetEnumSelectList<ModelProfileType>()"
                            data-auto-submit>
                    </select>
                    <span asp-validation-for="ModelProfileType" class="text-danger"></span>
                    <div class="form-text">This chooses which measurements we ask for.</div>
                </div>
            </fieldset>

            @if (Model.Template.Count > 0)
            {
                <fieldset class="mb-4">
                    <legend class="h5">Measurements</legend>

                    @for (var i = 0; i < Model.Measurements.Count; i++)
                    {
                        var field = Model.Template.FirstOrDefault(f => f.Key == Model.Measurements[i].Key);
                        if (field is null) { continue; }

                        <div class="row align-items-end mb-3">
                            <input type="hidden" asp-for="Measurements[i].Key" />

                            <div class="col-md-6">
                                <label asp-for="Measurements[i].Value" class="form-label">
                                    @field.Label @(field.Required ? "" : "(optional)")
                                </label>
                                <input asp-for="Measurements[i].Value" class="form-control"
                                       inputmode="decimal" />
                            </div>

                            <div class="col-md-4">
                                @if (field.AllowsUnitChoice)
                                {
                                    <label asp-for="Measurements[i].Unit" class="form-label">Unit</label>
                                    <select asp-for="Measurements[i].Unit" class="form-select">
                                        <option value="@((int)MeasurementUnit.Centimetres)">Centimetres</option>
                                        <option value="@((int)MeasurementUnit.Inches)">Inches</option>
                                    </select>
                                }
                                else
                                {
                                    <input type="hidden" asp-for="Measurements[i].Unit" />
                                    <span class="form-text">UK sizing</span>
                                }
                            </div>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HairColour" class="form-label"></label>
                            <input asp-for="HairColour" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EyeColour" class="form-label"></label>
                            <input asp-for="EyeColour" class="form-control" />
                        </div>
                    </div>
                </fieldset>
            }

            <fieldset class="mb-4">
                <legend class="h5">About me</legend>

                <div class="mb-3">
                    <label asp-for="Biography" class="form-label"></label>
                    <textarea asp-for="Biography" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Biography" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="InstagramUrl" class="form-label"></label>
                        <input asp-for="InstagramUrl" class="form-control" placeholder="https://instagram.com/..." />
                        <span asp-validation-for="InstagramUrl" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="TikTokUrl" class="form-label"></label>
                        <input asp-for="TikTokUrl" class="form-control" placeholder="https://tiktok.com/@@..." />
                        <span asp-validation-for="TikTokUrl" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            @if (Model.GuardianRequired)
            {
                <fieldset class="mb-4 border rounded p-3">
                    <legend class="h5">Parent or guardian</legend>
                    <p>
                        Because you are under 18, we need approval from your parent or legal
                        guardian. We will email them a link to approve.
                    </p>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="GuardianName" class="form-label"></label>
                            <input asp-for="GuardianName" class="form-control" />
                            <span asp-validation-for="GuardianName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="GuardianRelationship" class="form-label"></label>
                            <input asp-for="GuardianRelationship" class="form-control"
                                   placeholder="Parent, guardian" />
                            <span asp-validation-for="GuardianRelationship" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="GuardianEmail" class="form-label"></label>
                            <input asp-for="GuardianEmail" class="form-control" />
                            <span asp-validation-for="GuardianEmail" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="GuardianPhone" class="form-label"></label>
                            <input asp-for="GuardianPhone" class="form-control" />
                            <span asp-validation-for="GuardianPhone" class="text-danger"></span>
                        </div>
                    </div>
                </fieldset>
            }

            <button type="submit" class="btn btn-primary btn-lg">Submit my details</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
