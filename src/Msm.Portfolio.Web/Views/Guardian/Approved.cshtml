@model Msm.Portfolio.Web.ViewModels.GuardianApprovalViewModel
@{
    ViewData["Title"] = "Approval recorded";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1>Thank you</h1>
        <p class="lead">
            Your approval for @Model.ClientName has been recorded.
        </p>
        <p>
            @Model.BusinessName can now continue preparing their portfolio. There is
            nothing further you need to do.
        </p>
    </div>
</div>
