@*
    Light/dark switch. The icons are inline SVG rather than an icon font or an image
    request: the Content Security Policy allows no external origin, and one more round
    trip for two 15px glyphs is not worth it.

    Only one icon is ever visible — the stylesheet shows whichever depicts the
    appearance the button switches to.
*@
<button type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label="Switch appearance">
    <svg class="icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 2v2.4M12 19.6V22M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2 12h2.4M19.6 12H22M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7" />
    </svg>
    <svg class="icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8Z" />
    </svg>
</button>
